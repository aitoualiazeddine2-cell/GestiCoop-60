<Window x:Class="GestiCoop.Views.AjouterEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un étudiant"
        Width="460"
        Height="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <Border Background="#1F4E79">
            <TextBlock Text="Ajouter un étudiant"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0"/>
        </Border>

        <!-- Champs du formulaire -->
        <StackPanel Grid.Row="1" Margin="20">

            <!-- Nom et prénom -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Nom *"
                               Foreground="#1F4E79"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtNom"
                             Height="35"
                             Padding="8,0"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Prénom *"
                               Foreground="#1F4E79"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtPrenom"
                             Height="35"
                             Padding="8,0"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Courriel -->
            <TextBlock Text="Courriel *"
                       Foreground="#1F4E79"
                       Margin="0,20,0,5"/>

            <TextBox x:Name="txtCourriel"
                     Height="35"
                     Padding="8,0"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Exemple : prenom.nom@etud.lacite.ca"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="0,5,0,0"/>

            <!-- Programme -->
            <TextBlock Text="Programme *"
                       Foreground="#1F4E79"
                       Margin="0,20,0,5"/>

            <ComboBox x:Name="cboProgramme"
                      Height="35"
                      Padding="8,0"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Informatique"/>
                <ComboBoxItem Content="Génie logiciel"/>
                <ComboBoxItem Content="Cybersécurité"/>
            </ComboBox>

            <!-- Numéro d’étudiant -->
            <TextBlock Text="Numéro d'étudiant (optionnel)"
                       Foreground="#1F4E79"
                       Margin="0,20,0,5"/>

            <TextBox x:Name="txtNumeroEtudiant"
                     Height="35"
                     MaxLength="7"
                     Padding="8,0"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Format : 7 chiffres (ex. : 2024001)"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Boutons -->
        <Border Grid.Row="2"
                BorderBrush="#D2D6DC"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">

                <Button x:Name="btnAnnuler"
                        Content="Annuler"
                        Width="90"
                        Height="35"
                        Background="White"
                        Foreground="#1F4E79"
                        BorderBrush="#1F4E79"
                        Margin="0,0,10,0"/>

                <Button x:Name="btnEnregistrer"
                        Content="Enregistrer"
                        Width="110"
                        Height="35"
                        Background="#1F4E79"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>