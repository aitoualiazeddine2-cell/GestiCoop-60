<Window x:Class="GestiCoop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop"
        Height="650"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre supérieure -->
        <Border Background="#203766">
            <TextBlock Text="GestiCoop — Gestion des stages coopératifs"
                       Foreground="White"
                       FontSize="15"
                       Margin="20,0"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu à gauche -->
            <Grid Background="#243E72">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20">
                    <TextBlock Text="GestiCoop"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Stages coopératifs"
                               Foreground="#AABAD7"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#DDE5F4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="20,14"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="PRINCIPAL"
                               Foreground="#91A6CB"
                               FontSize="11"
                               Margin="20,10"/>

                    <Button Content="Tableau de bord"/>
                    <Button Content="Offres de stage"/>

                    <Button Content="Étudiants"
                            Background="#39568B"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button Content="Candidatures"/>
                    <Button Content="Entreprises"/>
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#435B87"
                        BorderThickness="0,1,0,0"
                        Padding="20,15">
                    <StackPanel>
                        <TextBlock Text="A.Azeddin"
                                   Foreground="White"/>
                        <TextBlock Text="etudiants"
                                   Foreground="#AABAD7"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Partie principale -->
            <Grid Grid.Column="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <TextBlock Text="Liste des étudiants"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#263247"
                           VerticalAlignment="Top"/>

                <Button Content="+ Ajouter un étudiant"
                        Background="#C83E32"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="18,10"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"/>

                <!-- Recherche et filtre -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="Rechercher un étudiant..."
                             Foreground="#929292"
                             Background="White"
                             BorderBrush="#D2D6DC"
                             BorderThickness="1"
                             Padding="10"
                             Margin="0,0,15,0"
                             VerticalContentAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              SelectedIndex="0"
                              Padding="8"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tous les programmes"/>
                        <ComboBoxItem Content="Informatique"/>
                        <ComboBoxItem Content="Génie logiciel"/>
                        <ComboBoxItem Content="Cybersécurité"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2"
                               Text="5 étudiants"
                               Foreground="#626B78"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Tableau -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#D2D6DC"
                        BorderThickness="1"
                        CornerRadius="4">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>

                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="Badge" TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="0,4"/>
                                <Setter Property="Margin" Value="5,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </Grid.Resources>

                        <!-- En-têtes -->
                        <Border Grid.ColumnSpan="5" Background="#EBEEF2"/>

                        <TextBlock Text="NOM" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="PRÉNOM" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="PROGRAMME" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="COURRIEL" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="ACTIONS" FontWeight="SemiBold"/>

                        <!-- Séparateurs -->
                        <Border Grid.Row="1" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="2" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="3" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="4" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="5" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>

                        <!-- Étudiant 1 -->
                        <TextBlock Grid.Row="1" Text="Tremblay"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Sophie"/>

                        <Border Grid.Row="1" Grid.Column="2"
                                Style="{StaticResource Badge}" Background="#DCE8FA">
                            <TextBlock Text="Informatique" Foreground="#315886"/>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="s.tremblay@etud.lacite.ca"/>

                        <StackPanel Grid.Row="1" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier" Foreground="#315E78"/>
                            <Button Content="Supprimer" Foreground="#9C493B"/>
                        </StackPanel>

                        <!-- Étudiant 2 -->
                        <TextBlock Grid.Row="2" Text="Nguyen"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Minh"/>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource Badge}" Background="#DCE8FA">
                            <TextBlock Text="Informatique" Foreground="#315886"/>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Text="m.nguyen@etud.lacite.ca"/>

                        <StackPanel Grid.Row="2" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier" Foreground="#315E78"/>
                            <Button Content="Supprimer" Foreground="#9C493B"/>
                        </StackPanel>

                        <!-- Étudiant 3 -->
                        <TextBlock Grid.Row="3" Text="Dubois"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Élodie"/>

                        <Border Grid.Row="3" Grid.Column="2"
                                Style="{StaticResource Badge}" Background="#DDEEDC">
                            <TextBlock Text="Génie logiciel" Foreground="#396A3B"/>
                        </Border>

                        <TextBlock Grid.Row="3" Grid.Column="3"
                                   Text="e.dubois@etud.lacite.ca"/>

                        <StackPanel Grid.Row="3" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier" Foreground="#315E78"/>
                            <Button Content="Supprimer" Foreground="#9C493B"/>
                        </StackPanel>

                        <!-- Étudiant 4 -->
                        <TextBlock Grid.Row="4" Text="Okonkwo"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Chidi"/>

                        <Border Grid.Row="4" Grid.Column="2"
                                Style="{StaticResource Badge}" Background="#FFF0C2">
                            <TextBlock Text="Cybersécurité" Foreground="#7B641C"/>
                        </Border>

                        <TextBlock Grid.Row="4" Grid.Column="3"
                                   Text="c.okonkwo@etud.lacite.ca"/>

                        <StackPanel Grid.Row="4" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier" Foreground="#315E78"/>
                            <Button Content="Supprimer" Foreground="#9C493B"/>
                        </StackPanel>

                        <!-- Étudiant 5 -->
                        <TextBlock Grid.Row="5" Text="Lavoie"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Xavier"/>

                        <Border Grid.Row="5" Grid.Column="2"
                                Style="{StaticResource Badge}" Background="#DCE8FA">
                            <TextBlock Text="Informatique" Foreground="#315886"/>
                        </Border>

                        <TextBlock Grid.Row="5" Grid.Column="3"
                                   Text="x.lavoie@etud.lacite.ca"/>

                        <StackPanel Grid.Row="5" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier" Foreground="#315E78"/>
                            <Button Content="Supprimer" Foreground="#9C493B"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Barre d’état -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                    <Ellipse Width="8" Height="8"
                             Fill="#519A59"
                             Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>