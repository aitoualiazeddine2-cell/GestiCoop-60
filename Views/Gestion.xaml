<Window x:Class="GestiCoop.Views.Gestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop — Étudiants"
        Width="1200" Height="700"
        MinWidth="1100" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- Apparence des boutons du menu -->
        <Style x:Key="BoutonMenu" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Apparence des boutons dans le tableau -->
        <Style x:Key="BoutonAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#315E78"/>
        </Style>

        <!-- Apparence des textes du tableau -->
        <Style x:Key="TexteTableau" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Étiquette du programme -->
        <Style x:Key="Etiquette" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#DCE8FA"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre supérieure -->
        <Border Background="#203766">
            <TextBlock Text="GestiCoop — Gestion des stages coopératifs"
                       Foreground="White"
                       Margin="20,0"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu à gauche -->
            <Grid Background="#243E72">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20">
                    <TextBlock Text="GestiCoop"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Stages coopératifs"
                               Foreground="#AABAD7"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="PRINCIPAL"
                               Foreground="#AABAD7"
                               FontSize="11"
                               Margin="20,10"/>

                    <Button Content="Tableau de bord"
                            Style="{StaticResource BoutonMenu}"/>

                    <Button Content="Offres de stage"
                            Style="{StaticResource BoutonMenu}"/>

                    <Button Content="●  Étudiants"
                            Style="{StaticResource BoutonMenu}"
                            Background="#39568B"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button Content="Candidatures"
                            Style="{StaticResource BoutonMenu}"/>

                    <Button Content="Entreprises"
                            Style="{StaticResource BoutonMenu}"/>
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#435B87"
                        BorderThickness="0,1,0,0"
                        Padding="20,15">
                    <StackPanel>
                        <TextBlock Text="A.Azeddine" Foreground="White"/>
                        <TextBlock Text="Etudiant"
                                   Foreground="#AABAD7"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Contenu principal -->
            <Grid Grid.Column="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Liste des étudiants"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#263247"/>

                <Button Content="+ Ajouter un étudiant"
                        Background="#C83E32"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"/>

                <!-- Recherche et filtre -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="Rechercher un étudiant..."
                             Foreground="#888888"
                             Padding="10"
                             Margin="0,0,15,0"
                             BorderBrush="#CCD2DA"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              SelectedIndex="0"
                              Padding="8"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tous les programmes"/>
                        <ComboBoxItem Content="Informatique"/>
                        <ComboBoxItem Content="Génie logiciel"/>
                        <ComboBoxItem Content="Cybersécurité"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2"
                               Text="5 étudiants"
                               Foreground="#687386"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Tableau avec des données fixes -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#D2D6DC"
                        BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Resources>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TexteTableau}"/>
                        </Grid.Resources>

                        <!-- En-têtes -->
                        <Border Grid.ColumnSpan="5" Background="#EAF0F6"/>

                        <TextBlock Text="NOM" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="PRÉNOM" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="PROGRAMME" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="COURRIEL" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="ACTIONS" FontWeight="SemiBold"/>

                        <!-- Lignes de séparation -->
                        <Border Grid.Row="1" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="2" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="3" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="4" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="5" Grid.ColumnSpan="5"
                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"/>

                        <!-- Étudiante 1 -->
                        <TextBlock Grid.Row="1" Text="Tremblay"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Sophie"/>

                        <Border Grid.Row="1" Grid.Column="2"
                                Style="{StaticResource Etiquette}">
                            <TextBlock Text="Informatique" Margin="0"
                                       Foreground="#315886"/>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="s.tremblay@etud.lacite.ca"/>

                        <StackPanel Grid.Row="1" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier"
                                    Style="{StaticResource BoutonAction}"/>
                            <Button Content="Supprimer"
                                    Style="{StaticResource BoutonAction}"
                                    Foreground="#A34436"/>
                        </StackPanel>

                        <!-- Étudiant 2 -->
                        <TextBlock Grid.Row="2" Text="Nguyen"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Minh"/>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource Etiquette}">
                            <TextBlock Text="Informatique" Margin="0"
                                       Foreground="#315886"/>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Text="m.nguyen@etud.lacite.ca"/>

                        <StackPanel Grid.Row="2" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier"
                                    Style="{StaticResource BoutonAction}"/>
                            <Button Content="Supprimer"
                                    Style="{StaticResource BoutonAction}"
                                    Foreground="#A34436"/>
                        </StackPanel>

                        <!-- Étudiante 3 -->
                        <TextBlock Grid.Row="3" Text="Dubois"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Élodie"/>

                        <Border Grid.Row="3" Grid.Column="2"
                                Style="{StaticResource Etiquette}"
                                Background="#DDEEDC">
                            <TextBlock Text="Génie logiciel" Margin="0"
                                       Foreground="#396A3B"/>
                        </Border>

                        <TextBlock Grid.Row="3" Grid.Column="3"
                                   Text="e.dubois@etud.lacite.ca"/>

                        <StackPanel Grid.Row="3" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier"
                                    Style="{StaticResource BoutonAction}"/>
                            <Button Content="Supprimer"
                                    Style="{StaticResource BoutonAction}"
                                    Foreground="#A34436"/>
                        </StackPanel>

                        <!-- Étudiant 4 -->
                        <TextBlock Grid.Row="4" Text="Okonkwo"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Chidi"/>

                        <Border Grid.Row="4" Grid.Column="2"
                                Style="{StaticResource Etiquette}"
                                Background="#FFF0C2">
                            <TextBlock Text="Cybersécurité" Margin="0"
                                       Foreground="#7B641C"/>
                        </Border>

                        <TextBlock Grid.Row="4" Grid.Column="3"
                                   Text="c.okonkwo@etud.lacite.ca"/>

                        <StackPanel Grid.Row="4" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier"
                                    Style="{StaticResource BoutonAction}"/>
                            <Button Content="Supprimer"
                                    Style="{StaticResource BoutonAction}"
                                    Foreground="#A34436"/>
                        </StackPanel>

                        <!-- Étudiant 5 -->
                        <TextBlock Grid.Row="5" Text="Lavoie"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Xavier"/>

                        <Border Grid.Row="5" Grid.Column="2"
                                Style="{StaticResource Etiquette}">
                            <TextBlock Text="Informatique" Margin="0"
                                       Foreground="#315886"/>
                        </Border>

                        <TextBlock Grid.Row="5" Grid.Column="3"
                                   Text="x.lavoie@etud.lacite.ca"/>

                        <StackPanel Grid.Row="5" Grid.Column="4"
                                    Orientation="Horizontal">
                            <Button Content="Modifier"
                                    Style="{StaticResource BoutonAction}"/>
                            <Button Content="Supprimer"
                                    Style="{StaticResource BoutonAction}"
                                    Foreground="#A34436"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Barre d’état -->
            </Grid>
        </Grid>
    </Grid>
</Window>