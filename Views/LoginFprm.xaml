<Window x:Class="GestiCoop.Views.LoginFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop"
        Width="900"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"

            Background ="#1f4E79"

            CornerRadius ="0">
            <StackPanel VerticalAlignment="Center"

                    HorizontalAlignment="Center">
                <TextBlock Text="Gesticorp"

                       FontSize="38"

                       FontWeight ="Bold"

                       Foreground="White"

                       HorizontalAlignment="Center"/>
                <TextBlock Text="Gestión de Recursos Humanos"

                       FontSize="20"

                       Foreground="White"

                       HorizontalAlignment="Center"

                       Margin="0,20,0,0"/>


                <StackPanel Orientation="Horizontal"

                       HorizontalAlignment="Center"

                       Margin="0,30,0,0">
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock Text="248"

                               FontSize="18"

                               Foreground="White"

                               HorizontalAlignment="Center"/>
                        <TextBlock Text="etudiant.e.s"

                               FontSize="18"

                               Foreground="White"

                               HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock Text="87"

                               FontSize="18"

                               Foreground="White"

                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Offres"

                               FontSize="18"

                               Foreground="White"

                               HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock Text="34"

           FontSize="18"

           Foreground="White"

           HorizontalAlignment="Center"/>
                        <TextBlock Text="Entreprises"

           FontSize="18"

           Foreground="White"

           HorizontalAlignment="Center"/>
                    </StackPanel>



                </StackPanel>
            </StackPanel>


        </Border>
        <Border Grid.Column="1"

            Background="White"

            Padding="40">
            <StackPanel VerticalAlignment="Center">

            </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Background="White"
                Padding="40,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Connexion"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1f4E79"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,20">
                        <RadioButton Content="Etudiant" Margin="0,0,10,0" GroupName="Role"/>
                        <RadioButton Content="Entreprise" Margin="0,0,10,0" GroupName="Role"/>
                        <RadioButton Content="Cordinateur" GroupName="Role"/>
                    </StackPanel>
                    <TextBlock Text="Nom d'utilisateur"
                           FontSize="14"
                           Foreground="#1f4E79"
                           Margin="0,0,0,5"/>
                    <TextBox Height="30" Width="250" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Mot de passe"
                   FontSize="14"
                   Foreground="#1f4E79"
                   Margin="0,0,0,5"/>
        <PasswordBox Height="30" Width="250" />
    </StackPanel>

    <Button Content="Se connecter"
            Background="#1f4E79"
            Foreground="White"
            Width="250"
            Height="35"
            Margin="0,20,0,0" />

    <Button Content="Connexion SSO La Cité"
            Background="White"
            Foreground="Black"
            Width="250"
            Height="35"
            Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
    

</Window>